cd cli

# All checks target clif-d.js (a symlink to ../bin/clif-d).
# The symlink gives ESLint a file within its base path and gives TypeScript a .js extension.

echo "Checking formatting..."
npx prettier --check clif-d.js

echo "Linting..."
npx eslint clif-d.js

echo "Type checking..."
npx tsc --noEmit

echo "Running tests..."
test_files=$(find test -name '*.test.js' 2>/dev/null)
if [ -n "$test_files" ]; then
  node --test $test_files
else
  echo "No test files found -- skipping."
fi
