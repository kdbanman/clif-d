      { code: 0, description: "Context item added and PRD written." },
      { code: 1, description: "Validation error (shape, duplicate id)." },
      { code: 2, description: "PRD file is missing or unparseable." },
    ],
  },
  "ctx edit": {
    usage: "clif-d ctx edit <CTX-ID> [prd-path] < patch.json",
    description:
      "Update fields on a context item. Replace semantics. Cannot change 'id'.",
    exitCodes: [
      { code: 0, description: "Context item updated and PRD written." },
      { code: 1, description: "Validation error." },
      { code: 2, description: "Usage error or PRD file missing/unparseable." },
    ],
  },
  "arch ls": {
    usage: "clif-d arch ls [flags] [prd-path]",
    description: "List architecture items from the PRD.",
    flags: [
      {
        flag: "--level <val>",
        description:
          "Filter by C4 level (comma-separated: context, container, component)",
      },
      {
        flag: "--fields, -f <val>",
        description: "Comma-separated fields (default: id,title,level)",
      },
      { flag: "--plain", description: "Plain tabular text output" },
    ],
  },
  "arch show": {
    usage: "clif-d arch show <ARCH-ID> [prd-path]",
    description: "Show the full JSON object for a single architecture item.",
  },
  "arch add": {
    usage: "clif-d arch add [prd-path] < item.json",
    description:
      "Add a new architecture item from a JSON object on stdin. If 'id' is omitted, the next ARCH-NNN is auto-assigned.",
    exitCodes: [
      { code: 0, description: "Architecture item added and PRD written." },
      { code: 1, description: "Validation error (shape, duplicate id)." },
      { code: 2, description: "PRD file is missing or unparseable." },
    ],
  },
  "arch edit": {
    usage: "clif-d arch edit <ARCH-ID> [prd-path] < patch.json",
    description:
      "Update fields on an architecture item. Replace semantics. Cannot change 'id'.",
    exitCodes: [
      {
        code: 0,
        description: "Architecture item updated and PRD written.",
      },
      { code: 1, description: "Validation error." },
      { code: 2, description: "Usage error or PRD file missing/unparseable." },
    ],
  },
  validate: {
    usage: "clif-d validate [prd-path]",
    description:
      "Validate PRD structural integrity. Checks ID uniqueness and format, referential integrity of dependencies, context_refs, and architecture_refs, dependency graph acyclicity, status/implementation_commit consistency, required fields, and enum values.",
    exitCodes: [
      { code: 0, description: "PRD is valid (no errors; warnings allowed)." },
      { code: 1, description: "PRD has one or more validation errors." },
      { code: 2, description: "PRD file is missing or unparseable." },
    ],
  },
};

/**
 * @param {string} key
 */
function writeHelp(key) {
  const spec = /** @type {HelpSpec} */ (HELP_SPECS[key]);
  stderr.write(Help.renderCommand(spec));
}

function printMainHelp() {
  stderr.write("Usage: clif-d <command> [args] [flags] [prd-path]\n");
  stderr.write("\n");
  stderr.write("Commands:\n");
  stderr.write("  req ls       List requirements\n");
  stderr.write("  req show     Show a single requirement\n");
  stderr.write("  req next     Find next implementable requirement\n");
  stderr.write("  req start    Mark requirement in-progress\n");
  stderr.write("  req done     Mark requirement done\n");
  stderr.write("  req block    Mark requirement blocked\n");
  stderr.write("  req add      Add a requirement (JSON on stdin)\n");
  stderr.write("  req edit     Edit requirement fields (JSON on stdin)\n");
  stderr.write("  req dep      Add, remove, or graph dependency edges\n");
  stderr.write("  ctx ls       List context items\n");
  stderr.write("  ctx show     Show a single context item\n");
  stderr.write("  ctx add      Add a context item (JSON on stdin)\n");
  stderr.write("  ctx edit     Edit context item fields (JSON on stdin)\n");
  stderr.write("  arch ls      List architecture items\n");
  stderr.write("  arch show    Show a single architecture item\n");
  stderr.write("  arch add     Add an architecture item (JSON on stdin)\n");
  stderr.write(
    "  arch edit    Edit architecture item fields (JSON on stdin)\n",
  );
  stderr.write("  validate     Validate PRD structural integrity\n");
  stderr.write("  id next      Print the next available ID\n");
  stderr.write("  schema copy  Copy PRD schema to a directory\n");
  stderr.write("\n");
  stderr.write("Run clif-d <command> --help for command-specific usage.\n");
}

// -- Router -----------------------------------------------------------------

/**
 * Dispatch subcommands for a generic item domain (ctx or arch).
 * @param {string | undefined} command
 * @param {string[]} commandArgs
 * @param {DomainConfig} cfg
 */
function routeItemDomain(command, commandArgs, cfg) {
  const flags = parseFlags(commandArgs);
  const helpRequested = flags.boolean.has("--help") || flags.boolean.has("-h");
  const commandLabel = `${cfg.domain} ${String(command)}`;
  const knownFlags = COMMAND_FLAG_SPECS[commandLabel];

  if (helpRequested && knownFlags !== undefined) {
    writeHelp(commandLabel);
    exit(0);
  }
  if (knownFlags === undefined) {
    stderr.write(`Unknown ${cfg.domain} command: ${String(command)}\n`);
    return exit(2);
  }
  enforceKnownFlags(flags, knownFlags, commandLabel);

  const expectPositional = command === "show" || command === "edit" ? 1 : 0;
  const prdPath = resolvePrdPath(flags, expectPositional);
  const prd = loadPrd(prdPath);

  switch (command) {
    case "ls": {
      itemLs(prd, flags, cfg);
      break;
    }
    case "show": {
      itemShow(prd, flags, cfg);
      break;
    }
    case "add": {
      itemAdd(prdPath, prd, cfg);
      break;
    }
    case "edit": {
      itemEdit(prdPath, prd, flags, cfg);
      break;
    }
    default: {
      stderr.write(`Unknown ${cfg.domain} command: ${String(command)}\n`);
      exit(2);
    }
  }
}

/**
 * Dispatch `schema` subcommands. Currently only `copy`.
 * @param {string | undefined} command
 * @param {string[]} commandArgs
 */
function routeSchema(command, commandArgs) {
  const flags = parseFlags(commandArgs);
  if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
    writeHelp("schema copy");
    exit(0);
  }
  if (command !== "copy") {
    stderr.write(`Unknown schema command: ${String(command)}\n`);
    return exit(2);
  }
  enforceKnownFlags(
    flags,
    COMMAND_FLAG_SPECS["schema copy"] ?? [],
    "schema copy",
  );
  schemaCopy(flags);
}

/**
 * Dispatch `id` subcommands. Currently only `next`.
 * @param {string | undefined} command
 * @param {string[]} commandArgs
 */
function routeId(command, commandArgs) {
  const flags = parseFlags(commandArgs);
  if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
    writeHelp("id next");
    exit(0);
  }
  if (command !== "next") {
    stderr.write(`Unknown id command: ${String(command)}\n`);
    return exit(2);
  }
  enforceKnownFlags(flags, COMMAND_FLAG_SPECS["id next"] ?? [], "id next");
  const prdPath = resolvePrdPath(flags, 1);
  const prd = loadPrd(prdPath);
  idNext(prd, flags);
}

/**
 * Dispatch `req` subcommands. Extracted from main to keep function length
 * and nesting depth within backpressure limits.
 * @param {string | undefined} command
 * @param {string[]} commandArgs
 */
function routeReq(command, commandArgs) {
  const flags = parseFlags(commandArgs);
  const helpRequested = flags.boolean.has("--help") || flags.boolean.has("-h");
  const commandLabel = `req ${String(command)}`;
  const knownFlags = COMMAND_FLAG_SPECS[commandLabel];

  // dep delegates help and flag enforcement to routeReqDep (graph has its own flags)
  if (command !== "dep") {
    if (helpRequested && knownFlags !== undefined) {
      writeHelp(commandLabel);
      exit(0);
    }
    if (knownFlags === undefined) {
      stderr.write(`Unknown req command: ${String(command)}\n`);
      return exit(2);
    }
    enforceKnownFlags(flags, knownFlags, commandLabel);
  } else if (knownFlags === undefined) {
    stderr.write(`Unknown req command: ${String(command)}\n`);
    return exit(2);
  }

  switch (command) {
    case "ls": {
      const prdPath = resolvePrdPath(flags, 0);
      const prd = loadPrd(prdPath);
      reqLs(prd, flags);
      break;
    }
    case "show": {
      const prdPath = resolvePrdPath(flags, 1);
      const prd = loadPrd(prdPath);
      reqShow(prd, flags);
      break;
    }
    case "block": {
      const prdPath = resolvePrdPath(flags, 1);
      const prd = loadPrd(prdPath);
      reqBlock(prdPath, prd, flags);
      break;
    }
    case "done": {
      const prdPath = resolvePrdPath(flags, 1);
      const prd = loadPrd(prdPath);
      reqDone(prdPath, prd, flags);
      break;
    }
    case "start": {
      const prdPath = resolvePrdPath(flags, 1);
      const prd = loadPrd(prdPath);
      reqStart(prdPath, prd, flags);
      break;
    }
    case "next": {
      const prdPath = resolvePrdPath(flags, 0);
      const prd = loadPrd(prdPath);
      reqNext(prd);
      break;
    }
    case "add": {
      const prdPath = resolvePrdPath(flags, 0);
      const prd = loadPrd(prdPath);
      reqAdd(prdPath, prd);
      break;
    }
    case "edit": {
      const prdPath = resolvePrdPath(flags, 1);
      const prd = loadPrd(prdPath);
      reqEdit(prdPath, prd, flags);
      break;
    }
    case "dep": {
      routeReqDep(flags, commandArgs);
      break;
    }
    default: {
      stderr.write(`Unknown req command: ${String(command)}\n`);
      exit(2);
    }
  }
}

/**
 * Dispatch `req dep` subcommands: `add`, `rm`, `graph`.
 * Extracted from main to keep nesting depth and function length in check.
 * @param {ParsedFlags} flags
 * @param {string[]} commandArgs
 */
function routeReqDep(flags, commandArgs) {
  const depVerb = flags.positional[0];
  if (!depVerb && (flags.boolean.has("--help") || flags.boolean.has("-h"))) {
    writeHelp("req dep");
    exit(0);
  }
  switch (depVerb) {
    case "graph": {
      const graphFlags = parseFlags(commandArgs.slice(1));
      if (graphFlags.boolean.has("--help") || graphFlags.boolean.has("-h")) {
        writeHelp("req dep graph");
        exit(0);
      }
      enforceKnownFlags(
        graphFlags,
        COMMAND_FLAG_SPECS["req dep graph"] ?? [],
        "req dep graph",
      );
      const prdPath = resolvePrdPath(graphFlags, 0);
      const prd = loadPrd(prdPath);
      reqDepGraph(prd, graphFlags);
      break;
    }
    case "add": {
      const prdPath = resolvePrdPath(flags, 3);
      const prd = loadPrd(prdPath);
      reqDepAdd(prdPath, prd, flags);
      break;
    }
    case "rm": {
      const prdPath = resolvePrdPath(flags, 3);
      const prd = loadPrd(prdPath);
      reqDepRm(prdPath, prd, flags);
      break;
    }
    default: {
      stderr.write(`Unknown req dep verb: ${String(depVerb)}\n`);
      exit(2);
    }
  }
}

if (require.main === module) {
  main();
}

if (process.env.CLIF_D_TEST_EXPORTS) {
  module.exports = {
    __testMode: true,
    Lookup,
    Lifecycle,
    Filters,
    Sort,
    Projection,
    Format,
    selectBestCandidate,
    Help,
    Validation,
  };
}

function main() {
  const args = argv.slice(2);

  if (args.length === 0) {
    printMainHelp();
    exit(2);
  }

  if (args.length === 1 && (args[0] === "--help" || args[0] === "-h")) {
    printMainHelp();
    exit(0);
  }

  const domain = args[0];
  const command = args[1];
  const commandArgs = args.slice(2);

  switch (domain) {
    case "req": {
      routeReq(command, commandArgs);
      break;
    }
    case "ctx": {
      routeItemDomain(command, commandArgs, CTX_CONFIG);
      break;
    }
    case "arch": {
      routeItemDomain(command, commandArgs, ARCH_CONFIG);
      break;
    }
    case "id": {
      routeId(command, args.slice(2));
      break;
    }
    case "schema": {
      routeSchema(command, args.slice(2));
      break;
    }
    case "validate": {
      const flags = parseFlags(args.slice(1));
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        writeHelp("validate");
        exit(0);
      }
      enforceKnownFlags(
        flags,
        COMMAND_FLAG_SPECS["validate"] ?? [],
        "validate",
      );
      const prdPath = resolvePrdPath(flags, 0);
      const prd = loadPrd(prdPath, { validate: false });
      runValidate(prd);
      break;
    }
    default: {
      stderr.write(`Unknown command: ${args.join(" ")}\n`);
      exit(2);
    }
  }
}
