#!/usr/bin/env node
// @ts-check
"use strict";

/**
 * clif-d -- CLI for CLIF-D PRD operations.
 *
 * Zero dependencies. Node.js 18+ built-in modules only.
 * See cli/clif-d/backpressure.md for quality guardrails.
 * See cli-prd.json for the full requirements specification.
 */

const fs = require("node:fs");
const path = require("node:path");
const { argv, exit, stdout, stderr } = process;

/** @type {readonly string[]} */
const SCHEMA_FIELD_ORDER = [
  "id",
  "description",
  "title",
  "acceptance_criteria",
  "priority",
  "dependencies",
  "abstraction_level",
  "status",
  "implementation_commit",
  "context_refs",
  "architecture_refs",
  "cli_spec",
];

const DEFAULT_FIELDS = [
  "id",
  "title",
  "status",
  "abstraction_level",
  "priority",
];

// -- Flag parsing -----------------------------------------------------------

/**
 * @typedef {Object} ParsedFlags
 * @property {Map<string, string>} named - Flags with values (--key=val or --key val)
 * @property {Set<string>} boolean - Boolean flags (--flag with no value)
 * @property {string[]} positional - Non-flag arguments
 */

/**
 * Parse argv into named flags, boolean flags, and positional arguments.
 * Supports --key=value, --key value, -k value, and bare --flag.
 * @param {string[]} args
 * @returns {ParsedFlags}
 */
function parseFlags(args) {
  /** @type {Map<string, string>} */
  const named = new Map();
  /** @type {Set<string>} */
  const booleanFlags = new Set();
  /** @type {string[]} */
  const positional = [];

  const flagsWithValues = new Set([
    "--status",
    "-s",
    "--abstraction",
    "-a",
    "--fields",
    "-f",
  ]);

  for (let i = 0; i < args.length; i++) {
    const arg = /** @type {string} */ (args[i]);
    if (arg.includes("=") && arg.startsWith("--")) {
      const eqIndex = arg.indexOf("=");
      named.set(arg.slice(0, eqIndex), arg.slice(eqIndex + 1));
    } else if (flagsWithValues.has(arg) && i + 1 < args.length) {
      named.set(arg, /** @type {string} */ (args[i + 1]));
      i++;
    } else if (
      arg.startsWith("--") ||
      (arg.startsWith("-") && arg.length === 2)
    ) {
      booleanFlags.add(arg);
    } else {
      positional.push(arg);
    }
  }

  return { named, boolean: booleanFlags, positional };
}

// -- PRD loading ------------------------------------------------------------

/**
 * Resolve the PRD file path from parsed flags.
 * The last positional arg is treated as a prd-path if it ends with .json
 * or contains a path separator. Otherwise defaults to clif-d/prd.json in cwd.
 * @param {ParsedFlags} flags
 * @param {number} expectedPositional - Number of expected positional args before prd-path
 * @returns {string}
 */
function resolvePrdPath(flags, expectedPositional) {
  const positionals = flags.positional;
  if (positionals.length > expectedPositional) {
    const last = /** @type {string} */ (positionals.at(-1));
    if (
      last.endsWith(".json") ||
      last.includes(path.sep) ||
      last.includes("/")
    ) {
      return path.resolve(last);
    }
  }
  return path.resolve("clif-d", "prd.json");
}

/**
 * Read and parse a PRD file. Calls process.exit(2) on error.
 * @param {string} prdPath
 * @returns {object}
 */
function loadPrd(prdPath) {
  /** @type {string} */
  let raw = "";
  try {
    // eslint-disable-next-line security/detect-non-literal-fs-filename -- prd-path is user-supplied by design
    raw = fs.readFileSync(prdPath, "utf8");
  } catch {
    stderr.write(`Error: PRD file not found: ${prdPath}\n`);
    return exit(2);
  }
  try {
    return JSON.parse(raw);
  } catch {
    stderr.write(`Error: Failed to parse PRD as JSON: ${prdPath}\n`);
    return exit(2);
  }
}

// -- Field selection --------------------------------------------------------

/**
 * Build a result object with only the selected fields in schema order.
 * @param {object} req - The full requirement object
 * @param {string[]} fields - Fields to include
 * @returns {object}
 */
function selectFields(req, fields) {
  const fieldSet = new Set(fields);
  /** @type {Record<string, unknown>} */
  const result = {};
  const source = /** @type {Record<string, unknown>} */ (req);

  for (const key of SCHEMA_FIELD_ORDER) {
    if (!fieldSet.has(key)) {
      continue;
    }
    if (key === "status") {
      result[key] = source[key] ?? "not_started";
    } else if (key === "dependencies") {
      result[key] = source[key] ?? [];
    } else if (key in source) {
      result[key] = source[key];
    }
  }
  return result;
}

// -- Command handlers -------------------------------------------------------

/**
 * @param {object} prd
 * @param {ParsedFlags} flags
 */
function reqLs(prd, flags) {
  const prdObj =
    /** @type {{ requirements: Array<Record<string, unknown>> }} */ (prd);
  let reqs = prdObj.requirements;

  const statusFilter = flags.named.get("--status") ?? flags.named.get("-s");
  if (statusFilter) {
    const statuses = new Set(statusFilter.split(","));
    reqs = reqs.filter((r) => {
      const status = /** @type {string} */ (r.status ?? "not_started");
      return statuses.has(status);
    });
  }

  const abstractionFilter =
    flags.named.get("--abstraction") ?? flags.named.get("-a");
  if (abstractionFilter) {
    reqs = reqs.filter((r) => r.abstraction_level === abstractionFilter);
  }

  if (flags.boolean.has("--priority")) {
    reqs = [...reqs].sort((a, b) => {
      const ap = /** @type {number | undefined} */ (a.priority);
      const bp = /** @type {number | undefined} */ (b.priority);
      if (ap === undefined && bp === undefined) {
        return 0;
      }
      if (ap === undefined) {
        return 1;
      }
      if (bp === undefined) {
        return -1;
      }
      return ap - bp;
    });
  }

  let fields = DEFAULT_FIELDS;
  const customFields = flags.named.get("--fields") ?? flags.named.get("-f");
  if (customFields) {
    fields = customFields.split(",");
  }
  if (flags.boolean.has("--deps") && !fields.includes("dependencies")) {
    fields = [...fields, "dependencies"];
  }

  if (flags.boolean.has("--plain")) {
    stdout.write(`${fields.join("\t")}\n`);
    for (const req of reqs) {
      const selected = selectFields(req, fields);
      const values = fields.map((f) => {
        const v = /** @type {Record<string, unknown>} */ (selected)[f];
        if (v === undefined || v === null) {
          return "";
        }
        if (typeof v === "object") {
          return JSON.stringify(v);
        }
        return String(v);
      });
      stdout.write(`${values.join("\t")}\n`);
    }
    exit(0);
  }

  const output = reqs.map((r) => selectFields(r, fields));
  stdout.write(`${JSON.stringify(output, null, 2)}\n`);
  exit(0);
}

/**
 * @param {object} prd
 * @param {ParsedFlags} flags
 */
function reqShow(prd, flags) {
  const positionals = flags.positional;
  if (positionals.length === 0) {
    stderr.write("Error: REQ-ID argument is required.\n");
    stderr.write("Usage: clif-d req show <REQ-ID> [prd-path]\n");
    exit(2);
    return; // unreachable; satisfies TypeScript control flow
  }

  const reqId = /** @type {string} */ (positionals[0]);
  const prdObj =
    /** @type {{ requirements: Array<Record<string, unknown>> }} */ (prd);
  const req = prdObj.requirements.find((r) => r.id === reqId);

  if (!req) {
    stderr.write(`Error: Requirement ${reqId} not found in PRD.\n`);
    exit(1);
    return; // unreachable; satisfies TypeScript control flow
  }

  stdout.write(`${JSON.stringify(fullRequirementObject(req), null, 2)}\n`);
  exit(0);
}

/**
 * Build a full requirement object in canonical schema order, filling
 * defaults for status and dependencies.
 * @param {Record<string, unknown>} req
 * @returns {Record<string, unknown>}
 */
function fullRequirementObject(req) {
  /** @type {Record<string, unknown>} */
  const result = {};
  for (const key of SCHEMA_FIELD_ORDER) {
    if (key === "status") {
      result[key] = req[key] ?? "not_started";
    } else if (key === "dependencies") {
      result[key] = req[key] ?? [];
    } else if (key in req) {
      result[key] = req[key];
    }
  }
  return result;
}

/**
 * @param {object} prd
 */
function reqNext(prd) {
  const prdObj =
    /** @type {{ requirements: Array<Record<string, unknown>> }} */ (prd);
  const reqs = prdObj.requirements;

  /** @type {Set<string>} */
  const doneIds = new Set();
  for (const r of reqs) {
    if (r.status === "done") {
      doneIds.add(/** @type {string} */ (r.id));
    }
  }

  /** @type {Record<string, unknown> | null} */
  let best = null;
  /** @type {number | undefined} */
  let bestPriority;

  for (const r of reqs) {
    const status = r.status ?? "not_started";
    if (status !== "not_started") {
      continue;
    }
    const deps = /** @type {string[] | undefined} */ (r.dependencies) ?? [];
    if (!deps.every((d) => doneIds.has(d))) {
      continue;
    }
    const pri = /** @type {number | undefined} */ (r.priority);
    if (best === null) {
      best = r;
      bestPriority = pri;
      continue;
    }
    if (pri === undefined) {
      continue;
    }
    if (bestPriority === undefined || pri < bestPriority) {
      best = r;
      bestPriority = pri;
    }
  }

  if (best === null) {
    stderr.write(
      "Error: No eligible requirement: all requirements are done, in_progress, blocked, or have unmet dependencies.\n",
    );
    exit(1);
    return;
  }

  stdout.write(`${JSON.stringify(fullRequirementObject(best), null, 2)}\n`);
  exit(0);
}

// -- Help text --------------------------------------------------------------

function printMainHelp() {
  stderr.write("Usage: clif-d <command> [args] [flags] [prd-path]\n");
  stderr.write("\n");
  stderr.write("Commands:\n");
  stderr.write("  req ls       List requirements\n");
  stderr.write("  req show     Show a single requirement\n");
  stderr.write("  req next     Find next implementable requirement\n");
  stderr.write("  req start    Mark requirement in-progress\n");
  stderr.write("  req done     Mark requirement done\n");
  stderr.write("  req block    Mark requirement blocked\n");
  stderr.write("  validate     Validate PRD structural integrity\n");
  stderr.write("\n");
  stderr.write("Run clif-d <command> --help for command-specific usage.\n");
}

function printReqLsHelp() {
  stderr.write("Usage: clif-d req ls [flags] [prd-path]\n");
  stderr.write("\n");
  stderr.write("List requirements from the PRD.\n");
  stderr.write("\n");
  stderr.write("Flags:\n");
  stderr.write(
    "  --status, -s <val>       Filter by status (comma-separated).\n",
  );
  stderr.write(
    "                           Values: not_started, in_progress, done, blocked\n",
  );
  stderr.write(
    "  --abstraction, -a <val>  Filter by abstraction_level: high or low\n",
  );
  stderr.write(
    "  --priority               Sort by priority ascending (unranked last)\n",
  );
  stderr.write(
    "  --fields, -f <val>       Comma-separated fields to include\n",
  );
  stderr.write(
    "                           Default: id,title,status,abstraction_level,priority\n",
  );
  stderr.write(
    "  --deps                   Include dependencies field in output\n",
  );
  stderr.write("  --json                   JSON output (default)\n");
  stderr.write("  --plain                  Plain tabular text output\n");
}

function printReqShowHelp() {
  stderr.write("Usage: clif-d req show <REQ-ID> [prd-path]\n");
  stderr.write("\n");
  stderr.write("Show the full JSON object for a single requirement.\n");
}

function printReqNextHelp() {
  stderr.write("Usage: clif-d req next [prd-path]\n");
  stderr.write("\n");
  stderr.write("Print the highest-priority not_started requirement whose\n");
  stderr.write("dependencies are all done.\n");
  stderr.write("\n");
  stderr.write("Exit codes:\n");
  stderr.write("  0  An eligible requirement was found and printed.\n");
  stderr.write("  1  No eligible requirement exists.\n");
  stderr.write("  2  PRD file is missing or unparseable.\n");
}

// -- Router -----------------------------------------------------------------

const args = argv.slice(2);

if (args.length === 0) {
  printMainHelp();
  exit(2);
}

if (args.length === 1 && (args[0] === "--help" || args[0] === "-h")) {
  printMainHelp();
  exit(0);
}

const domain = args[0];
const command = args[1];
const commandArgs = args.slice(2);

if (domain === "req") {
  const flags = parseFlags(commandArgs);

  switch (command) {
    case "ls": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqLsHelp();
        exit(0);
      }
      const prdPath = resolvePrdPath(flags, 0);
      const prd = loadPrd(prdPath);
      reqLs(prd, flags);
      break;
    }
    case "show": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqShowHelp();
        exit(0);
      }
      const prdPath = resolvePrdPath(flags, 1);
      const prd = loadPrd(prdPath);
      reqShow(prd, flags);
      break;
    }
    case "next": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqNextHelp();
        exit(0);
      }
      const prdPath = resolvePrdPath(flags, 0);
      const prd = loadPrd(prdPath);
      reqNext(prd);
      break;
    }
    default: {
      stderr.write(`Unknown req command: ${command}\n`);
      exit(2);
    }
  }
} else {
  stderr.write(`Unknown command: ${args.join(" ")}\n`);
  exit(2);
}
