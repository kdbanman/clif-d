// -- Router -----------------------------------------------------------------

const args = argv.slice(2);

if (args.length === 0) {
  printMainHelp();
  exit(2);
}

if (args.length === 1 && (args[0] === "--help" || args[0] === "-h")) {
  printMainHelp();
  exit(0);
}

const domain = args[0];
const command = args[1];
const commandArgs = args.slice(2);

if (domain === "req") {
  const flags = parseFlags(commandArgs);

  switch (command) {
    case "ls": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqLsHelp();
        exit(0);
      }
      const prdPath = resolvePrdPath(flags, 0);
      const prd = loadPrd(prdPath);
      reqLs(prd, flags);
      break;
    }
    case "show": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqShowHelp();
        exit(0);
      }
      const prdPath = resolvePrdPath(flags, 1);
      const prd = loadPrd(prdPath);
      reqShow(prd, flags);
      break;
    }
    case "block": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqBlockHelp();
        exit(0);
      }
      const prdPath = resolvePrdPath(flags, 1);
      const prd = loadPrd(prdPath);
      reqBlock(prdPath, prd, flags);
      break;
    }
    case "done": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqDoneHelp();
        exit(0);
      }
      const prdPath = resolvePrdPath(flags, 1);
      const prd = loadPrd(prdPath);
      reqDone(prdPath, prd, flags);
      break;
    }
    case "start": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqStartHelp();
        exit(0);
      }
      const prdPath = resolvePrdPath(flags, 1);
      const prd = loadPrd(prdPath);
      reqStart(prdPath, prd, flags);
      break;
    }
    case "next": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqNextHelp();
        exit(0);
      }
      const prdPath = resolvePrdPath(flags, 0);
      const prd = loadPrd(prdPath);
      reqNext(prd);
      break;
    }
    case "add": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqAddHelp();
        exit(0);
      }
      const prdPath = resolvePrdPath(flags, 0);
      const prd = loadPrd(prdPath);
      reqAdd(prdPath, prd);
      break;
    }
    case "edit": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqEditHelp();
        exit(0);
      }
      const prdPath = resolvePrdPath(flags, 1);
      const prd = loadPrd(prdPath);
      reqEdit(prdPath, prd, flags);
      break;
    }
    case "dep": {
      if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
        printReqDepHelp();
        exit(0);
      }
      const depVerb = flags.positional[0];
      const prdPath = resolvePrdPath(flags, 3);
      const prd = loadPrd(prdPath);
      if (depVerb === "add") {
        reqDepAdd(prdPath, prd, flags);
      } else if (depVerb === "rm") {
        reqDepRm(prdPath, prd, flags);
      } else {
        stderr.write(`Unknown req dep verb: ${String(depVerb)}\n`);
        exit(2);
      }
      break;
    }
    default: {
      stderr.write(`Unknown req command: ${command}\n`);
      exit(2);
    }
  }
} else if (domain === "validate") {
  const flags = parseFlags(args.slice(1));
  if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
    printValidateHelp();
    exit(0);
  }
  const prdPath = resolvePrdPath(flags, 0);
  const prd = loadPrd(prdPath);
  runValidate(prd);
} else {
  stderr.write(`Unknown command: ${args.join(" ")}\n`);
  exit(2);
}
