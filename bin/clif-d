/**
 * @param {string} key
 */
function writeHelp(key) {
  const spec = /** @type {HelpSpec} */ (HELP_SPECS[key]);
  stderr.write(Help.renderCommand(spec));
}

function printMainHelp() {
  stderr.write("Usage: clif-d <command> [args] [flags] [prd-path]\n");
  stderr.write("\n");
  stderr.write("Commands:\n");
  stderr.write("  req ls       List requirements\n");
  stderr.write("  req show     Show a single requirement\n");
  stderr.write("  req next     Find next implementable requirement\n");
  stderr.write("  req start    Mark requirement in-progress\n");
  stderr.write("  req done     Mark requirement done\n");
  stderr.write("  req block    Mark requirement blocked\n");
  stderr.write("  req add      Add a requirement (JSON on stdin)\n");
  stderr.write("  req edit     Edit requirement fields (JSON on stdin)\n");
  stderr.write("  req dep      Add or remove dependency edges\n");
  stderr.write("  ctx ls       List context items\n");
  stderr.write("  ctx show     Show a single context item\n");
  stderr.write("  ctx add      Add a context item (JSON on stdin)\n");
  stderr.write("  ctx edit     Edit context item fields (JSON on stdin)\n");
  stderr.write("  arch ls      List architecture items\n");
  stderr.write("  arch show    Show a single architecture item\n");
  stderr.write("  arch add     Add an architecture item (JSON on stdin)\n");
  stderr.write(
    "  arch edit    Edit architecture item fields (JSON on stdin)\n",
  );
  stderr.write("  validate     Validate PRD structural integrity\n");
  stderr.write("\n");
  stderr.write("Run clif-d <command> --help for command-specific usage.\n");
}

// -- Router -----------------------------------------------------------------

if (require.main === module) {
  main();
}

if (process.env.CLIF_D_TEST_EXPORTS) {
  module.exports = {
    __testMode: true,
    Lookup,
    Lifecycle,
    Filters,
    Sort,
    Projection,
    Format,
    selectBestCandidate,
    Help,
    Validation,
  };
}

function main() {
  const args = argv.slice(2);

  if (args.length === 0) {
    printMainHelp();
    exit(2);
  }

  if (args.length === 1 && (args[0] === "--help" || args[0] === "-h")) {
    printMainHelp();
    exit(0);
  }

  const domain = args[0];
  const command = args[1];
  const commandArgs = args.slice(2);

  switch (domain) {
    case "req": {
      dispatchReq(command, commandArgs);
      break;
    }
    case "ctx": {
      dispatchItemDomain("ctx", command, commandArgs, CTX_SPEC);
      break;
    }
    case "arch": {
      dispatchItemDomain("arch", command, commandArgs, ARCH_SPEC);
      break;
    }
    case "validate": {
      dispatchValidate(args.slice(1));
      break;
    }
    default: {
      stderr.write(`Unknown command: ${args.join(" ")}\n`);
      exit(2);
    }
  }
}

/**
 * Handle the `req` domain: parse flags, enforce them, then dispatch to the
 * matching handler. Extracted from `main` so each domain stays within the
 * function-size gate.
 * @param {string | undefined} command
 * @param {string[]} commandArgs
 */
function dispatchReq(command, commandArgs) {
  const flags = parseFlags(commandArgs);
  const helpRequested = flags.boolean.has("--help") || flags.boolean.has("-h");
  const commandLabel = `req ${String(command)}`;
  const knownFlags = COMMAND_FLAG_SPECS[commandLabel];

  if (helpRequested && knownFlags !== undefined) {
    writeHelp(commandLabel);
    exit(0);
  }
  if (knownFlags === undefined) {
    stderr.write(`Unknown req command: ${String(command)}\n`);
    return exit(2);
  }
  enforceKnownFlags(flags, knownFlags, commandLabel);
  runReqCommand(command, flags);
}

/**
 * @param {string | undefined} command
 * @param {ParsedFlags} flags
 */
function runReqCommand(command, flags) {
  switch (command) {
    case "ls": {
      const prdPath = resolvePrdPath(flags, 0);
      reqLs(loadPrd(prdPath), flags);
      break;
    }
    case "show": {
      const prdPath = resolvePrdPath(flags, 1);
      reqShow(loadPrd(prdPath), flags);
      break;
    }
    case "block": {
      const prdPath = resolvePrdPath(flags, 1);
      reqBlock(prdPath, loadPrd(prdPath), flags);
      break;
    }
    case "done": {
      const prdPath = resolvePrdPath(flags, 1);
      reqDone(prdPath, loadPrd(prdPath), flags);
      break;
    }
    case "start": {
      const prdPath = resolvePrdPath(flags, 1);
      reqStart(prdPath, loadPrd(prdPath), flags);
      break;
    }
    case "next": {
      const prdPath = resolvePrdPath(flags, 0);
      reqNext(loadPrd(prdPath));
      break;
    }
    case "add": {
      const prdPath = resolvePrdPath(flags, 0);
      reqAdd(prdPath, loadPrd(prdPath));
      break;
    }
    case "edit": {
      const prdPath = resolvePrdPath(flags, 1);
      reqEdit(prdPath, loadPrd(prdPath), flags);
      break;
    }
    case "dep": {
      runReqDep(flags);
      break;
    }
    default: {
      stderr.write(`Unknown req command: ${String(command)}\n`);
      exit(2);
    }
  }
}

/**
 * @param {ParsedFlags} flags
 */
function runReqDep(flags) {
  const depVerb = flags.positional[0];
  const prdPath = resolvePrdPath(flags, 3);
  const prd = loadPrd(prdPath);
  if (depVerb === "add") {
    reqDepAdd(prdPath, prd, flags);
  } else if (depVerb === "rm") {
    reqDepRm(prdPath, prd, flags);
  } else {
    stderr.write(`Unknown req dep verb: ${String(depVerb)}\n`);
    exit(2);
  }
}

/**
 * Handle a ctx/arch domain: same verb set for both (ls/show/add/edit).
 * @param {"ctx" | "arch"} domain
 * @param {string | undefined} command
 * @param {string[]} commandArgs
 * @param {ItemDomainSpec} spec
 */
function dispatchItemDomain(domain, command, commandArgs, spec) {
  const flags = parseFlags(commandArgs);
  const helpRequested = flags.boolean.has("--help") || flags.boolean.has("-h");
  const commandLabel = `${domain} ${String(command)}`;
  const knownFlags = COMMAND_FLAG_SPECS[commandLabel];

  if (helpRequested && knownFlags !== undefined) {
    writeHelp(commandLabel);
    exit(0);
  }
  if (knownFlags === undefined) {
    stderr.write(`Unknown ${domain} command: ${String(command)}\n`);
    return exit(2);
  }
  enforceKnownFlags(flags, knownFlags, commandLabel);
  runItemCommand(command, flags, spec);
}

/**
 * @param {string | undefined} command
 * @param {ParsedFlags} flags
 * @param {ItemDomainSpec} spec
 */
function runItemCommand(command, flags, spec) {
  switch (command) {
    case "ls": {
      const prdPath = resolvePrdPath(flags, 0);
      itemLs(loadPrd(prdPath), flags, spec);
      break;
    }
    case "show": {
      const prdPath = resolvePrdPath(flags, 1);
      itemShow(loadPrd(prdPath), flags, spec);
      break;
    }
    case "add": {
      const prdPath = resolvePrdPath(flags, 0);
      itemAdd(prdPath, loadPrd(prdPath), spec);
      break;
    }
    case "edit": {
      const prdPath = resolvePrdPath(flags, 1);
      itemEdit(prdPath, loadPrd(prdPath), flags, spec);
      break;
    }
    default: {
      stderr.write(
        `Unknown ${spec.prefix.toLowerCase()} command: ${String(command)}\n`,
      );
      exit(2);
    }
  }
}

/**
 * @param {string[]} argsAfterDomain
 */
function dispatchValidate(argsAfterDomain) {
  const flags = parseFlags(argsAfterDomain);
  if (flags.boolean.has("--help") || flags.boolean.has("-h")) {
    writeHelp("validate");
    exit(0);
  }
  enforceKnownFlags(flags, COMMAND_FLAG_SPECS["validate"] ?? [], "validate");
  const prdPath = resolvePrdPath(flags, 0);
  const prd = loadPrd(prdPath, { validate: false });
  runValidate(prd);
}
