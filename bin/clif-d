#!/usr/bin/env node
// @ts-check
"use strict";

/**
 * clif-d -- CLI for CLIF-D PRD operations.
 *
 * Zero dependencies. Node.js 18+ built-in modules only.
 * See cli/clif-d/backpressure.md for quality guardrails.
 * See cli-prd.json for the full requirements specification.
 */

const fs = require("node:fs");
const path = require("node:path");
const { argv, exit, stdout, stderr } = process;

/** @type {readonly string[]} */
const SCHEMA_FIELD_ORDER = [
  "id",
  "description",
  "title",
  "acceptance_criteria",
  "priority",
  "dependencies",
  "abstraction_level",
  "status",
  "implementation_commit",
  "context_refs",
  "architecture_refs",
  "cli_spec",
];

const DEFAULT_FIELDS = [
  "id",
  "title",
  "status",
  "abstraction_level",
  "priority",
];

// -- Lookup namespace -------------------------------------------------------

/**
 * Pure helpers for locating items by ID in a PRD. `findRequirementOrExit`
 * accepts an `io` object so tests can supply their own exit/stderr without
 * touching process state.
 */
const Lookup = Object.freeze({
  /**
   * @param {object} prd
   * @param {string} reqId
   * @returns {Record<string, unknown> | undefined}
   */
  findRequirement(prd, reqId) {
    const reqs =
      /** @type {{ requirements: Array<Record<string, unknown>> }} */ (prd)
        .requirements;
    return reqs.find((r) => r.id === reqId);
  },

  /**
   * @param {object} prd
   * @param {string} reqId
   * @param {{ exit: (code: number) => void, stderr: { write: (s: string) => void } }} io
   * @returns {Record<string, unknown> | undefined}
   */
  findRequirementOrExit(prd, reqId, io) {
    const req = Lookup.findRequirement(prd, reqId);
    if (!req) {
      io.stderr.write(`Error: Requirement ${reqId} not found in PRD.\n`);
      io.exit(1);
    }
    return req;
  },
});

/**
 * Require the first positional argument (a REQ-ID) or exit 2 with a usage
 * diagnostic. Returns the REQ-ID string.
 * @param {ParsedFlags} flags
 * @param {string} usage - Command usage line (no trailing newline).
 * @returns {string}
 */
function requireReqIdPositional(flags, usage) {
  if (flags.positional.length === 0) {
    stderr.write("Error: REQ-ID argument is required.\n");
    stderr.write(`Usage: ${usage}\n`);
    exit(2);
  }
  return /** @type {string} */ (flags.positional[0]);
}

// -- Flag parsing -----------------------------------------------------------

/**
 * @typedef {Object} ParsedFlags
 * @property {Map<string, string>} named - Flags with values (--key=val or --key val)
 * @property {Set<string>} boolean - Boolean flags (--flag with no value)
 * @property {string[]} positional - Non-flag arguments
 */

/**
 * Parse argv into named flags, boolean flags, and positional arguments.
 * Supports --key=value, --key value, -k value, and bare --flag.
 * @param {string[]} args
 * @returns {ParsedFlags}
 */
function parseFlags(args) {
  /** @type {Map<string, string>} */
  const named = new Map();
  /** @type {Set<string>} */
  const booleanFlags = new Set();
  /** @type {string[]} */
  const positional = [];

  const flagsWithValues = new Set([
    "--status",
    "-s",
    "--abstraction",
    "-a",
    "--fields",
    "-f",
    "--commit",
    "-c",
    "--type",
    "--level",
  ]);

  for (let i = 0; i < args.length; i++) {
    const arg = /** @type {string} */ (args[i]);
    if (arg.includes("=") && arg.startsWith("--")) {
      const eqIndex = arg.indexOf("=");
      const key = arg.slice(0, eqIndex);
      const value = arg.slice(eqIndex + 1);
      if (value === "") {
        stderr.write(`Error: Flag ${key} requires a non-empty value.\n`);
        return exit(2);
      }
      named.set(key, value);
    } else if (flagsWithValues.has(arg) && i + 1 < args.length) {
      named.set(arg, /** @type {string} */ (args[i + 1]));
      i++;
    } else if (
      arg.startsWith("--") ||
      (arg.startsWith("-") && arg.length === 2)
    ) {
      booleanFlags.add(arg);
    } else {
      positional.push(arg);
    }
  }

  return { named, boolean: booleanFlags, positional };
}

/**
 * Allowed flag tokens (long and short forms) per command. `--help` and `-h`
 * are always allowed and are added by `enforceKnownFlags`. Duplicate-flag
 * policy: last wins (Map.set semantics in parseFlags).
 * @type {Readonly<Record<string, readonly string[]>>}
 */
const COMMAND_FLAG_SPECS = Object.freeze({
  "req ls": [
    "--status",
    "-s",
    "--abstraction",
    "-a",
    "--fields",
    "-f",
    "--priority",
    "--deps",
    "--plain",
  ],
  "req show": [],
  "req start": [],
  "req done": ["--commit", "-c"],
  "req block": [],
  "req next": [],
  "req add": [],
  "req edit": [],
  "req dep": [],
  "ctx ls": ["--type", "--fields", "-f", "--plain"],
  "ctx show": [],
  "ctx add": [],
  "ctx edit": [],
  "arch ls": ["--level", "--fields", "-f", "--plain"],
  "arch show": [],
  "arch add": [],
  "arch edit": [],
  validate: [],
});

/**
 * Exit with code 2 if any parsed flag is not in `allowed`. `--help` and `-h`
 * are always permitted.
 * @param {ParsedFlags} flags
 * @param {readonly string[]} allowed
 * @param {string} commandLabel
 */
function enforceKnownFlags(flags, allowed, commandLabel) {
  const allowedSet = new Set([...allowed, "--help", "-h"]);
  const seen = new Set([...flags.named.keys(), ...flags.boolean]);
  for (const key of seen) {
    if (!allowedSet.has(key)) {
      stderr.write(`Error: Unknown flag for ${commandLabel}: ${key}\n`);
      return exit(2);
    }
  }
}

// -- PRD loading ------------------------------------------------------------

/**
 * Resolve the PRD file path from parsed flags.
 * The last positional arg is treated as a prd-path if it ends with .json
 * or contains a path separator. Otherwise defaults to clif-d/prd.json in cwd.
 * @param {ParsedFlags} flags
 * @param {number} expectedPositional - Number of expected positional args before prd-path
 * @returns {string}
 */
function resolvePrdPath(flags, expectedPositional) {
  const positionals = flags.positional;
  if (positionals.length > expectedPositional) {
    const last = /** @type {string} */ (positionals.at(-1));
    if (
      last.endsWith(".json") ||
      last.includes(path.sep) ||
      last.includes("/")
    ) {
      return path.resolve(last);
    }
  }
  return path.resolve("clif-d", "prd.json");
}

/**
 * Read and parse a PRD file. On I/O or parse failure, exits 2. When
 * `options.validate` is true (the default), runs `Validation.all` on the
 * parsed PRD and exits 1 with one diagnostic per `error`-level issue if any
 * are found. The `validate` command passes `{ validate: false }` so it can
 * surface issues via its own output path rather than hard-exiting.
 * @param {string} prdPath
 * @param {{ validate?: boolean }} [options]
 * @returns {object}
 */
function loadPrd(prdPath, options) {
  /** @type {string} */
  let raw = "";
  try {
    // eslint-disable-next-line security/detect-non-literal-fs-filename -- prd-path is user-supplied by design
    raw = fs.readFileSync(prdPath, "utf8");
  } catch {
    stderr.write(`Error: PRD file not found: ${prdPath}\n`);
    return exit(2);
  }
  /** @type {object} */
  let parsed;
  try {
    parsed = JSON.parse(raw);
  } catch {
    stderr.write(`Error: Failed to parse PRD as JSON: ${prdPath}\n`);
    return exit(2);
  }

  const shouldValidate = options?.validate !== false;
  if (shouldValidate) {
    const issues = Validation.all(parsed);
    const errors = issues.filter((i) => i.level === "error");
    if (errors.length > 0) {
      for (const err of errors) {
        const who = err.id ? `${err.id}: ` : "";
        stderr.write(`Error: ${who}${err.message}\n`);
      }
      return exit(1);
    }
  }
  return parsed;
}

// -- Atomic write -----------------------------------------------------------

/**
 * Write the PRD atomically: serialize, write to a temp file in the same
 * directory as the target, then rename. Ensures the target is never in a
 * half-written state.
 * @param {string} prdPath
 * @param {object} prd
 * @returns {void}
 */
function writePrd(prdPath, prd) {
  const json = `${JSON.stringify(prd, null, 2)}\n`;
  const tmpPath = `${prdPath}.tmp.${process.pid}`;
  // eslint-disable-next-line security/detect-non-literal-fs-filename -- prd-path is user-supplied by design
  fs.writeFileSync(tmpPath, json, "utf8");
  // eslint-disable-next-line security/detect-non-literal-fs-filename -- prd-path is user-supplied by design
  fs.renameSync(tmpPath, prdPath);
}

// -- Lifecycle namespace ----------------------------------------------------

/**
 * @typedef {{ ok: true } | { ok: false, reason: string }} TransitionResult
 */

/**
 * Status-transition predicates. Only `done` is terminal; every other
 * transition is allowed (including idempotent self-transitions and
 * unblocking via start).
 */
const Lifecycle = Object.freeze({
  /**
   * @param {string | undefined} currentStatus
   * @returns {TransitionResult}
   */
  canStart(currentStatus) {
    return currentStatus === "done"
      ? { ok: false, reason: "requirement is already done" }
      : { ok: true };
  },

  /**
   * @param {string | undefined} currentStatus
   * @returns {TransitionResult}
   */
  canComplete(currentStatus) {
    return currentStatus === "done"
      ? { ok: false, reason: "already done; done is terminal" }
      : { ok: true };
  },

  /**
   * @param {string | undefined} currentStatus
   * @returns {TransitionResult}
   */
  canBlock(currentStatus) {
    return currentStatus === "done"
      ? { ok: false, reason: "requirement is already done" }
      : { ok: true };
  },
});

// -- Stdin --------------------------------------------------------------

/**
 * Read stdin synchronously and parse it as JSON. On read failure exits 2;
 * on parse failure exits 1.
 * @returns {unknown}
 */
function readStdinJson() {
  /** @type {string} */
  let raw = "";
  try {
    raw = fs.readFileSync(0, "utf8");
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    stderr.write(`Error: failed to read stdin: ${message}\n`);
    return exit(2);
  }
  try {
    return JSON.parse(raw);
  } catch {
    stderr.write("Error: stdin is not valid JSON.\n");
    return exit(1);
  }
}

// -- Requirement shape validation --------------------------------------------

const REQUIRED_REQ_FIELDS = [
  "id",
  "title",
  "description",
  "acceptance_criteria",
  "abstraction_level",
];

/**
 * Validate the shape of a requirement object. Returns an array of error
 * messages; empty if valid. Does not check referential integrity or cycles.
 * @param {Record<string, unknown>} req
 * @param {{ requireAllFields: boolean }} options
 * @returns {string[]}
 */
function validateRequirementShape(req, options) {
  /** @type {string[]} */
  const errors = [];

  if (options.requireAllFields) {
    for (const field of REQUIRED_REQ_FIELDS) {
      const value = req[field];
      if (value === undefined || value === null || value === "") {
        errors.push(`Missing required field: ${field}`);
      }
    }
  }

  if ("id" in req && req.id !== undefined) {
    const id = req.id;
    if (typeof id !== "string" || !/^REQ-\d{3}$/.test(id)) {
      errors.push(`Invalid id '${String(id)}': must match REQ-NNN`);
    }
  }

  if (
    req.abstraction_level !== undefined &&
    !VALID_ABSTRACTION_LEVELS.has(/** @type {string} */ (req.abstraction_level))
  ) {
    errors.push(
      `Invalid abstraction_level '${String(req.abstraction_level)}': must be 'high' or 'low'`,
    );
  }

  if (
    req.status !== undefined &&
    !VALID_STATUSES.has(/** @type {string} */ (req.status))
  ) {
    errors.push(
      `Invalid status '${String(req.status)}': must be one of not_started, in_progress, done, blocked`,
    );
  }

  validateAcceptanceCriteria(req.acceptance_criteria, errors);

  const status = /** @type {string | undefined} */ (req.status);
  const commit = req.implementation_commit;
  if (status === "done" && !commit) {
    errors.push("Status is 'done' but implementation_commit is missing");
  }

  for (const field of ["dependencies", "context_refs", "architecture_refs"]) {
    const arr = req[field];
    if (arr !== undefined && !Array.isArray(arr)) {
      errors.push(`Invalid ${field}: must be an array`);
    }
  }

  return errors;
}

/**
 * Validate the shape of a requirement's acceptance_criteria field. Accepts
 * a non-empty string OR a {given, when, then} object whose three fields are
 * all non-empty strings. Pushes any failures onto `errors`.
 * @param {unknown} ac
 * @param {string[]} errors
 */
function validateAcceptanceCriteria(ac, errors) {
  if (ac === undefined || ac === null || ac === "") {
    return;
  }
  if (typeof ac === "string") {
    return;
  }
  if (typeof ac !== "object" || Array.isArray(ac)) {
    errors.push(
      "Invalid acceptance_criteria: must be a string or {given, when, then} object",
    );
    return;
  }
  const gwt = /** @type {Record<string, unknown>} */ (ac);
  for (const key of ["given", "when", "then"]) {
    if (typeof gwt[key] !== "string" || gwt[key] === "") {
      errors.push(
        `Invalid acceptance_criteria: object form requires string '${key}'`,
      );
    }
  }
}

const REQUIRED_CTX_FIELDS = ["id", "title", "description", "type"];
const REQUIRED_ARCH_FIELDS = ["id", "title", "description", "level"];

/**
 * Push a "Missing required field" error for each empty required field on
 * `item`. Shared by the three shape validators.
 * @param {Record<string, unknown>} item
 * @param {readonly string[]} required
 * @param {string[]} errors
 */
function collectMissingFields(item, required, errors) {
  for (const field of required) {
    const value = item[field];
    if (value === undefined || value === null || value === "") {
      errors.push(`Missing required field: ${field}`);
    }
  }
}

/**
 * If `item.id` is present, verify it matches `PREFIX-NNN`. Otherwise no-op.
 * @param {Record<string, unknown>} item
 * @param {string} prefix
 * @param {string[]} errors
 */
function collectIdFormatError(item, prefix, errors) {
  if (!("id" in item) || item.id === undefined) {
    return;
  }
  const id = item.id;
  const pattern = new RegExp(`^${prefix}-\\d{3}$`);
  if (typeof id !== "string" || !pattern.test(id)) {
    errors.push(`Invalid id '${String(id)}': must match ${prefix}-NNN`);
  }
}

/**
 * Push errors for optional fields that must be strings when present.
 * @param {Record<string, unknown>} item
 * @param {readonly string[]} fieldNames
 * @param {string[]} errors
 */
function collectOptionalStringErrors(item, fieldNames, errors) {
  for (const field of fieldNames) {
    const value = item[field];
    if (value !== undefined && typeof value !== "string") {
      errors.push(`Invalid ${field}: must be a string`);
    }
  }
}

/**
 * Validate the shape of a context item. Referential integrity is handled
 * elsewhere (context items have no outbound refs today).
 * @param {Record<string, unknown>} item
 * @param {{ requireAllFields: boolean }} options
 * @returns {string[]}
 */
function validateContextShape(item, options) {
  /** @type {string[]} */
  const errors = [];
  if (options.requireAllFields) {
    collectMissingFields(item, REQUIRED_CTX_FIELDS, errors);
  }
  collectIdFormatError(item, "CTX", errors);
  if (
    item.type !== undefined &&
    !VALID_CONTEXT_TYPES.has(/** @type {string} */ (item.type))
  ) {
    errors.push(
      `Invalid type '${String(item.type)}': must be one of non_functional, constraint, persona, domain, product_goal`,
    );
  }
  collectOptionalStringErrors(item, ["reference_link"], errors);
  return errors;
}

/**
 * Validate the shape of an architecture item.
 * @param {Record<string, unknown>} item
 * @param {{ requireAllFields: boolean }} options
 * @returns {string[]}
 */
function validateArchitectureShape(item, options) {
  /** @type {string[]} */
  const errors = [];
  if (options.requireAllFields) {
    collectMissingFields(item, REQUIRED_ARCH_FIELDS, errors);
  }
  collectIdFormatError(item, "ARCH", errors);
  if (
    item.level !== undefined &&
    !VALID_ARCH_LEVELS.has(/** @type {string} */ (item.level))
  ) {
    errors.push(
      `Invalid level '${String(item.level)}': must be one of context, container, component`,
    );
  }
  collectOptionalStringErrors(item, ["diagram_file", "reference_link"], errors);
  return errors;
}

/**
 * Compute the next PREFIX-NNN id by taking max+1 over existing numeric ids
 * in `items` whose `id` matches `^PREFIX-\d+$`. Always zero-pads to 3 digits.
 * Shared by `req add`, `ctx add`, and `arch add` so they all follow identical
 * "max+1, do not gap-fill" semantics.
 * @param {string} prefix
 * @param {Array<Record<string, unknown>>} items
 * @returns {string}
 */
function nextId(prefix, items) {
  const re = new RegExp(`^${prefix}-(\\d+)$`);
  const numbers = items
    .map((item) => {
      const id = /** @type {unknown} */ (item.id);
      if (typeof id !== "string") {
        return Number.NaN;
      }
      const match = re.exec(id);
      return match ? Number(match[1]) : Number.NaN;
    })
    .filter((n) => Number.isFinite(n));
  const next = (Math.max(0, ...numbers) + 1).toString().padStart(3, "0");
  return `${prefix}-${next}`;
}

/**
 * Compute the next REQ-NNN id. Thin wrapper over `nextId`.
 * @param {Array<Record<string, unknown>>} requirements
 * @returns {string}
 */
function nextReqId(requirements) {
  return nextId("REQ", requirements);
}

/**
 * Check referential integrity of a single requirement's ref arrays against
 * the PRD's ID sets. Returns error messages.
 * @param {Record<string, unknown>} req
 * @param {Set<string>} reqIds
 * @param {Set<string>} ctxIds
 * @param {Set<string>} archIds
 * @returns {string[]}
 */
function checkRequirementRefs(req, reqIds, ctxIds, archIds) {
  /** @type {string[]} */
  const errors = [];
  const checks = [
    { field: "dependencies", ids: reqIds },
    { field: "context_refs", ids: ctxIds },
    { field: "architecture_refs", ids: archIds },
  ];
  for (const { field, ids } of checks) {
    const refs = /** @type {unknown} */ (req[field]);
    if (!Array.isArray(refs)) {
      continue;
    }
    for (const ref of refs) {
      if (typeof ref !== "string" || !ids.has(ref)) {
        errors.push(`Dangling ${field} ref: ${String(ref)}`);
      }
    }
  }
  return errors;
}

/**
 * Returns true if the requirements array has a dependency cycle. Only edges
 * pointing to known IDs are traversed.
 * @param {Array<Record<string, unknown>>} requirements
 * @returns {boolean}
 */
function hasDependencyCycle(requirements) {
  const reqIds = collectIds(requirements);
  const graph = buildDependencyGraph(requirements, reqIds);
  const { color, WHITE, GRAY, BLACK } = initThreeColorState(graph);

  /**
   * @param {string} node
   * @returns {boolean}
   */
  function dfs(node) {
    color.set(node, GRAY);
    const edges = graph.get(node) ?? [];
    for (const next of edges) {
      const c = color.get(next);
      if (c === GRAY) {
        return true;
      }
      if (c === WHITE && dfs(next)) {
        return true;
      }
    }
    color.set(node, BLACK);
    return false;
  }

  for (const id of graph.keys()) {
    if (color.get(id) === WHITE && dfs(id)) {
      return true;
    }
  }
  return false;
}

// -- Filters / Sort / Projection / Format namespaces ------------------------

/**
 * Pure helpers for filtering a list of requirements.
 */
const Filters = Object.freeze({
  /**
   * @param {Array<Record<string, unknown>>} reqs
   * @param {Set<string>} statuses
   * @returns {Array<Record<string, unknown>>}
   */
  byStatus(reqs, statuses) {
    return reqs.filter((r) => {
      const status = /** @type {string} */ (r.status ?? "not_started");
      return statuses.has(status);
    });
  },

  /**
   * @param {Array<Record<string, unknown>>} reqs
   * @param {string} level
   * @returns {Array<Record<string, unknown>>}
   */
  byAbstraction(reqs, level) {
    return reqs.filter((r) => r.abstraction_level === level);
  },
});

/**
 * Pure helpers for sorting a list of requirements.
 */
const Sort = Object.freeze({
  /**
   * Sort ascending by numeric `priority`. Undefined priority is placed last.
   * Returns a new array; does not mutate the input.
   * @param {Array<Record<string, unknown>>} reqs
   * @returns {Array<Record<string, unknown>>}
   */
  byPriority(reqs) {
    return [...reqs].sort((a, b) => {
      const ap = /** @type {number | undefined} */ (a.priority);
      const bp = /** @type {number | undefined} */ (b.priority);
      if (ap === undefined && bp === undefined) {
        return 0;
      }
      if (ap === undefined) {
        return 1;
      }
      if (bp === undefined) {
        return -1;
      }
      return ap - bp;
    });
  },
});

/**
 * Field-selection helpers. Projection preserves SCHEMA_FIELD_ORDER and fills
 * defaults for status/dependencies when absent.
 */
const Projection = Object.freeze({
  /**
   * @param {Record<string, unknown>} req
   * @param {readonly string[]} fields
   * @returns {Record<string, unknown>}
   */
  selectFields(req, fields) {
    const fieldSet = new Set(fields);
    /** @type {Record<string, unknown>} */
    const result = {};
    for (const key of SCHEMA_FIELD_ORDER) {
      if (!fieldSet.has(key)) {
        continue;
      }
      if (key === "status") {
        result[key] = req[key] ?? "not_started";
      } else if (key === "dependencies") {
        result[key] = req[key] ?? [];
      } else if (key in req) {
        result[key] = req[key];
      }
    }
    return result;
  },
});

/**
 * Output-formatting helpers.
 */
const Format = Object.freeze({
  /**
   * Render a list of requirements as tab-separated text with a header row.
   * Object-valued fields are JSON-stringified; null/undefined become empty.
   * Projects requirements through `Projection.selectFields` (which preserves
   * `SCHEMA_FIELD_ORDER` and defaults status/dependencies); tabular rendering
   * is shared with ctx/arch via `renderTable`.
   * @param {Array<Record<string, unknown>>} reqs
   * @param {string[]} fields
   * @returns {string}
   */
  toPlain(reqs, fields) {
    const projected = reqs.map((r) => Projection.selectFields(r, fields));
    return renderTable(projected, fields);
  },
});

/**
 * Render a list of already-projected items (each is a plain object with the
 * caller's selected fields) as a tab-separated table with header row.
 * @param {Array<Record<string, unknown>>} rows
 * @param {readonly string[]} fields
 * @returns {string}
 */
function renderTable(rows, fields) {
  const lines = [fields.join("\t")];
  for (const row of rows) {
    const values = fields.map((f) => {
      const v = row[f];
      if (v === undefined || v === null) {
        return "";
      }
      if (typeof v === "object") {
        return JSON.stringify(v);
      }
      return String(v);
    });
    lines.push(values.join("\t"));
  }
  return `${lines.join("\n")}\n`;
}

// -- Command handlers -------------------------------------------------------

/**
 * @param {object} prd
 * @param {ParsedFlags} flags
 */
function reqLs(prd, flags) {
  const prdObj =
    /** @type {{ requirements: Array<Record<string, unknown>> }} */ (prd);
  let reqs = prdObj.requirements;

  const statusFilter = flags.named.get("--status") ?? flags.named.get("-s");
  if (statusFilter) {
    reqs = Filters.byStatus(reqs, new Set(statusFilter.split(",")));
  }

  const abstractionFilter =
    flags.named.get("--abstraction") ?? flags.named.get("-a");
  if (abstractionFilter) {
    reqs = Filters.byAbstraction(reqs, abstractionFilter);
  }

  if (flags.boolean.has("--priority")) {
    reqs = Sort.byPriority(reqs);
  }

  let fields = DEFAULT_FIELDS;
  const customFields = flags.named.get("--fields") ?? flags.named.get("-f");
  if (customFields) {
    fields = customFields.split(",");
  }
  if (flags.boolean.has("--deps") && !fields.includes("dependencies")) {
    fields = [...fields, "dependencies"];
  }

  if (flags.boolean.has("--plain")) {
    stdout.write(Format.toPlain(reqs, fields));
    exit(0);
  }

  const output = reqs.map((r) => Projection.selectFields(r, fields));
  stdout.write(`${JSON.stringify(output, null, 2)}\n`);
  exit(0);
}

/**
 * @param {object} prd
 * @param {ParsedFlags} flags
 */
function reqShow(prd, flags) {
  const reqId = requireReqIdPositional(
    flags,
    "clif-d req show <REQ-ID> [prd-path]",
  );
  const req = Lookup.findRequirementOrExit(prd, reqId, { exit, stderr });
  if (!req) {
    return; // unreachable; satisfies TypeScript control flow
  }

  stdout.write(`${JSON.stringify(fullRequirementObject(req), null, 2)}\n`);
  exit(0);
}

/**
 * Build a full requirement object in canonical schema order, filling
 * defaults for status and dependencies.
 * @param {Record<string, unknown>} req
 * @returns {Record<string, unknown>}
 */
function fullRequirementObject(req) {
  return Projection.selectFields(req, SCHEMA_FIELD_ORDER);
}

/**
 * Common tail for mutation handlers (reqEdit, reqDepAdd) that may introduce
 * a dependency cycle. If the post-mutation graph has a cycle, write the
 * caller-supplied error message and exit 1 without touching disk; otherwise
 * persist the PRD and print the updated requirement on stdout, exit 0.
 * @param {string} prdPath
 * @param {object} prd
 * @param {{ requirements: Array<Record<string, unknown>> }} prdObj
 * @param {Record<string, unknown>} req
 * @param {string} cycleMessage
 */
function commitWithCycleCheck(prdPath, prd, prdObj, req, cycleMessage) {
  if (hasDependencyCycle(prdObj.requirements)) {
    stderr.write(`${cycleMessage}\n`);
    exit(1);
    return;
  }
  writePrd(prdPath, prd);
  stdout.write(`${JSON.stringify(fullRequirementObject(req), null, 2)}\n`);
  exit(0);
}

/**
 * @param {object} prd
 */
/**
 * Select the highest-priority requirement from a list of eligible candidates.
 * Tiebreaker rule: lower numeric `priority` wins; undefined priority is
 * treated as the worst (candidates with a defined priority beat candidates
 * without one); among equally-undefined priorities, the first in input order
 * wins. Returns null on empty input.
 * @param {Array<Record<string, unknown>>} eligibleReqs
 * @returns {Record<string, unknown> | null}
 */
function selectBestCandidate(eligibleReqs) {
  /** @type {Record<string, unknown> | null} */
  let best = null;
  /** @type {number | undefined} */
  let bestPriority;

  for (const r of eligibleReqs) {
    const pri = /** @type {number | undefined} */ (r.priority);
    if (best === null) {
      best = r;
      bestPriority = pri;
      continue;
    }
    if (pri === undefined) {
      continue;
    }
    if (bestPriority === undefined || pri < bestPriority) {
      best = r;
      bestPriority = pri;
    }
  }
  return best;
}

/**
 * @param {object} prd
 */
function reqNext(prd) {
  const prdObj =
    /** @type {{ requirements: Array<Record<string, unknown>> }} */ (prd);
  const reqs = prdObj.requirements;

  /** @type {Set<string>} */
  const doneIds = new Set();
  for (const r of reqs) {
    if (r.status === "done") {
      doneIds.add(/** @type {string} */ (r.id));
    }
  }

  const eligible = reqs.filter((r) => {
    const status = r.status ?? "not_started";
    if (status !== "not_started") {
      return false;
    }
    const deps = /** @type {string[] | undefined} */ (r.dependencies) ?? [];
    return deps.every((d) => doneIds.has(d));
  });

  const best = selectBestCandidate(eligible);
  if (best === null) {
    stderr.write(
      "Error: No eligible requirement: all requirements are done, in_progress, blocked, or have unmet dependencies.\n",
    );
    exit(1);
    return;
  }

  stdout.write(`${JSON.stringify(fullRequirementObject(best), null, 2)}\n`);
  exit(0);
}

/**
 * Mark a requirement in_progress. Idempotent: starting an already in_progress
 * requirement succeeds. Starting a blocked requirement unblocks it.
 * @param {string} prdPath
 * @param {object} prd
 * @param {ParsedFlags} flags
 */
function reqStart(prdPath, prd, flags) {
  const reqId = requireReqIdPositional(
    flags,
    "clif-d req start <REQ-ID> [prd-path]",
  );
  const req = Lookup.findRequirementOrExit(prd, reqId, { exit, stderr });
  if (!req) {
    return;
  }

  const current = /** @type {string} */ (req.status ?? "not_started");
  const check = Lifecycle.canStart(current);
  if (!check.ok) {
    stderr.write(`Error: Cannot start ${reqId}: ${check.reason}.\n`);
    exit(1);
    return;
  }

  req.status = "in_progress";
  writePrd(prdPath, prd);
  stdout.write(`${JSON.stringify(fullRequirementObject(req), null, 2)}\n`);
  exit(0);
}

/**
 * Mark a requirement done with an implementation commit SHA. The commit SHA
 * is required and must be 7-40 hex characters. done is terminal: a done
 * requirement cannot be re-marked done.
 * @param {string} prdPath
 * @param {object} prd
 * @param {ParsedFlags} flags
 */
function reqDone(prdPath, prd, flags) {
  const reqId = requireReqIdPositional(
    flags,
    "clif-d req done <REQ-ID> --commit=<sha> [prd-path]",
  );
  const commit = flags.named.get("--commit") ?? flags.named.get("-c");
  if (!commit) {
    stderr.write(
      `Error: --commit flag is required for req done (the git commit SHA that completed ${reqId}).\n`,
    );
    exit(1);
    return;
  }
  if (!/^[0-9a-f]{7,40}$/i.test(commit)) {
    stderr.write(
      `Error: --commit must be a 7-40 character hex SHA. Got: ${commit}\n`,
    );
    exit(1);
    return;
  }

  const req = Lookup.findRequirementOrExit(prd, reqId, { exit, stderr });
  if (!req) {
    return;
  }

  const current = /** @type {string} */ (req.status ?? "not_started");
  const check = Lifecycle.canComplete(current);
  if (!check.ok) {
    stderr.write(`Error: Requirement ${reqId} is ${check.reason}.\n`);
    exit(1);
    return;
  }

  req.status = "done";
  req.implementation_commit = commit;
  writePrd(prdPath, prd);
  stdout.write(`${JSON.stringify(fullRequirementObject(req), null, 2)}\n`);
  exit(0);
}

/**
 * Mark a requirement blocked. Idempotent: blocking a blocked requirement
 * succeeds. done is terminal, so a done requirement cannot be blocked.
 * @param {string} prdPath
 * @param {object} prd
 * @param {ParsedFlags} flags
 */
function reqBlock(prdPath, prd, flags) {
  const reqId = requireReqIdPositional(
    flags,
    "clif-d req block <REQ-ID> [prd-path]",
  );
  const req = Lookup.findRequirementOrExit(prd, reqId, { exit, stderr });
  if (!req) {
    return;
  }

  const current = /** @type {string} */ (req.status ?? "not_started");
  const check = Lifecycle.canBlock(current);
  if (!check.ok) {
    stderr.write(`Error: Cannot block ${reqId}: ${check.reason}.\n`);
    exit(1);
    return;
  }

  req.status = "blocked";
  writePrd(prdPath, prd);
  stdout.write(`${JSON.stringify(fullRequirementObject(req), null, 2)}\n`);
  exit(0);
}

/**
 * Add a new requirement from stdin JSON. Auto-assigns id if missing.
 * @param {string} prdPath
 * @param {object} prd
 */
function reqAdd(prdPath, prd) {
  const body = readStdinJson();
  if (typeof body !== "object" || body === null || Array.isArray(body)) {
    stderr.write("Error: stdin must be a JSON object.\n");
    exit(1);
    return;
  }
  const input = /** @type {Record<string, unknown>} */ (body);
  const prdObj =
    /** @type {{ requirements: Array<Record<string, unknown>>, context: Array<Record<string, unknown>>, architecture: Array<Record<string, unknown>> }} */ (
      prd
    );
  const requirements = prdObj.requirements;

  const candidate = { ...input };
  if (candidate.id === undefined) {
    candidate.id = nextReqId(requirements);
  }

  exitOnShapeErrors(
    validateRequirementShape(candidate, { requireAllFields: true }),
  );

  const newId = /** @type {string} */ (candidate.id);
  exitOnDuplicateId(requirements, newId, "Requirement id");

  const newReq = fullRequirementObject(candidate);
  const speculative = [...requirements, newReq];

  const reqIds = collectIds(speculative);
  const ctxIds = collectIds(prdObj.context ?? []);
  const archIds = collectIds(prdObj.architecture ?? []);
  const refErrors = checkRequirementRefs(newReq, reqIds, ctxIds, archIds);
  if (refErrors.length > 0) {
    for (const err of refErrors) {
      stderr.write(`Error: ${err}\n`);
    }
    exit(1);
    return;
  }

  if (hasDependencyCycle(speculative)) {
    stderr.write(
      `Error: Adding ${newId} would introduce a dependency cycle.\n`,
    );
    exit(1);
    return;
  }

  requirements.push(newReq);
  writePrd(prdPath, prd);
  stdout.write(`${JSON.stringify(newReq, null, 2)}\n`);
  exit(0);
}

/**
 * Edit an existing requirement. Reads a partial JSON object from stdin and
 * applies it with replace semantics (arrays are replaced, not merged).
 * @param {string} prdPath
 * @param {object} prd
 * @param {ParsedFlags} flags
 */
function reqEdit(prdPath, prd, flags) {
  const reqId = requireReqIdPositional(
    flags,
    "clif-d req edit <REQ-ID> [prd-path] < patch.json",
  );
  const prdObj =
    /** @type {{ requirements: Array<Record<string, unknown>>, context: Array<Record<string, unknown>>, architecture: Array<Record<string, unknown>> }} */ (
      prd
    );
  const req = Lookup.findRequirementOrExit(prd, reqId, { exit, stderr });
  if (!req) {
    return;
  }

  const body = readStdinJson();
  if (typeof body !== "object" || body === null || Array.isArray(body)) {
    stderr.write("Error: stdin must be a JSON object.\n");
    exit(1);
    return;
  }
  const patch = /** @type {Record<string, unknown>} */ (body);

  if ("id" in patch) {
    stderr.write("Error: Cannot change id via req edit.\n");
    exit(1);
    return;
  }

  const merged = { ...req, ...patch };
  exitOnShapeErrors(
    validateRequirementShape(merged, { requireAllFields: true }),
  );

  const reqIds = collectIds(prdObj.requirements);
  const ctxIds = collectIds(prdObj.context ?? []);
  const archIds = collectIds(prdObj.architecture ?? []);
  const refErrors = checkRequirementRefs(merged, reqIds, ctxIds, archIds);
  if (refErrors.length > 0) {
    for (const err of refErrors) {
      stderr.write(`Error: ${err}\n`);
    }
    exit(1);
    return;
  }

  for (const key of Object.keys(patch)) {
    req[key] = patch[key];
  }

  commitWithCycleCheck(
    prdPath,
    prd,
    prdObj,
    req,
    `Error: Editing ${reqId} would introduce a dependency cycle.`,
  );
}

/**
 * Add a dependency edge from REQ-ID to DEP-ID. Enforces acyclicity.
 * @param {string} prdPath
 * @param {object} prd
 * @param {ParsedFlags} flags
 */
function reqDepAdd(prdPath, prd, flags) {
  const positionals = flags.positional;
  if (positionals.length < 3) {
    stderr.write("Error: req dep add requires REQ-ID and DEP-ID.\n");
    stderr.write("Usage: clif-d req dep add <REQ-ID> <DEP-ID> [prd-path]\n");
    exit(2);
    return;
  }

  const reqId = /** @type {string} */ (positionals[1]);
  const depId = /** @type {string} */ (positionals[2]);
  const prdObj =
    /** @type {{ requirements: Array<Record<string, unknown>> }} */ (prd);

  if (reqId === depId) {
    stderr.write(
      `Error: self-loop rejected: ${reqId} cannot depend on itself (cycle).\n`,
    );
    exit(1);
    return;
  }

  const req = Lookup.findRequirementOrExit(prd, reqId, { exit, stderr });
  if (!req) {
    return;
  }
  const dep = Lookup.findRequirement(prd, depId);
  if (!dep) {
    stderr.write(`Error: Dependency requirement ${depId} not found in PRD.\n`);
    exit(1);
    return;
  }

  const current = /** @type {unknown} */ (req.dependencies);
  const deps = Array.isArray(current) ? [...current] : [];
  if (deps.includes(depId)) {
    stderr.write(
      `Error: ${reqId} already has a dependency on ${depId} (duplicate edge).\n`,
    );
    exit(1);
    return;
  }

  req.dependencies = [...deps, depId];
  commitWithCycleCheck(
    prdPath,
    prd,
    prdObj,
    req,
    `Error: Adding ${reqId} -> ${depId} would introduce a dependency cycle.`,
  );
}

/**
 * Remove a dependency edge from REQ-ID to DEP-ID. Tolerates orphaned DEP-IDs.
 * @param {string} prdPath
 * @param {object} prd
 * @param {ParsedFlags} flags
 */
function reqDepRm(prdPath, prd, flags) {
  const positionals = flags.positional;
  if (positionals.length < 3) {
    stderr.write("Error: req dep rm requires REQ-ID and DEP-ID.\n");
    stderr.write("Usage: clif-d req dep rm <REQ-ID> <DEP-ID> [prd-path]\n");
    exit(2);
    return;
  }

  const reqId = /** @type {string} */ (positionals[1]);
  const depId = /** @type {string} */ (positionals[2]);

  const req = Lookup.findRequirementOrExit(prd, reqId, { exit, stderr });
  if (!req) {
    return;
  }

  const current = /** @type {unknown} */ (req.dependencies);
  const deps = Array.isArray(current) ? [...current] : [];
  if (!deps.includes(depId)) {
    stderr.write(
      `Error: edge not present: ${depId} is not a dependency of ${reqId}.\n`,
    );
    exit(1);
    return;
  }

  req.dependencies = deps.filter((d) => d !== depId);
  writePrd(prdPath, prd);
  stdout.write(`${JSON.stringify(fullRequirementObject(req), null, 2)}\n`);
  exit(0);
}

// -- ctx / arch CRUD --------------------------------------------------------

/** @type {readonly string[]} */
const CTX_SCHEMA_FIELD_ORDER = [
  "id",
  "title",
  "description",
  "type",
  "reference_link",
];

/** @type {readonly string[]} */
const ARCH_SCHEMA_FIELD_ORDER = [
  "id",
  "title",
  "description",
  "level",
  "diagram_file",
  "reference_link",
];

const CTX_DEFAULT_LIST_FIELDS = ["id", "title", "type"];
const ARCH_DEFAULT_LIST_FIELDS = ["id", "title", "level"];

/**
 * @typedef {Object} ItemDomainSpec
 * @property {string} prefix            - e.g. "CTX" or "ARCH".
 * @property {string} arrayKey          - PRD array key, e.g. "context".
 * @property {readonly string[]} schemaOrder
 * @property {readonly string[]} defaultListFields
 * @property {string} filterFlag        - e.g. "--type" or "--level".
 * @property {string} filterField       - field name corresponding to filterFlag.
 * @property {(item: Record<string, unknown>, options: { requireAllFields: boolean }) => string[]} validateShape
 * @property {string} notFoundLabel     - e.g. "Context item" or "Architecture item".
 */

/** @type {ItemDomainSpec} */
const CTX_SPEC = {
  prefix: "CTX",
  arrayKey: "context",
  schemaOrder: CTX_SCHEMA_FIELD_ORDER,
  defaultListFields: CTX_DEFAULT_LIST_FIELDS,
  filterFlag: "--type",
  filterField: "type",
  validateShape: validateContextShape,
  notFoundLabel: "Context item",
};

/** @type {ItemDomainSpec} */
const ARCH_SPEC = {
  prefix: "ARCH",
  arrayKey: "architecture",
  schemaOrder: ARCH_SCHEMA_FIELD_ORDER,
  defaultListFields: ARCH_DEFAULT_LIST_FIELDS,
  filterFlag: "--level",
  filterField: "level",
  validateShape: validateArchitectureShape,
  notFoundLabel: "Architecture item",
};

/**
 * Project an item onto a given set of fields, preserving a caller-supplied
 * schema order. Generic counterpart to `Projection.selectFields` (which
 * hard-codes the requirement schema order and defaults for status/deps).
 * @param {Record<string, unknown>} item
 * @param {readonly string[]} fields
 * @param {readonly string[]} schemaOrder
 * @returns {Record<string, unknown>}
 */
function projectItem(item, fields, schemaOrder) {
  const fieldSet = new Set(fields);
  /** @type {Record<string, unknown>} */
  const result = {};
  for (const key of schemaOrder) {
    if (fieldSet.has(key) && key in item) {
      result[key] = item[key];
    }
  }
  return result;
}

/**
 * Build a full item object in the given schema order, dropping fields not
 * present on the input. Used as the on-disk and stdout-canonical shape for
 * ctx/arch items (which have no defaulted fields -- unlike requirements).
 * @param {Record<string, unknown>} item
 * @param {readonly string[]} schemaOrder
 * @returns {Record<string, unknown>}
 */
function fullItemObject(item, schemaOrder) {
  return projectItem(item, schemaOrder, schemaOrder);
}

/**
 * Render a list of items as tab-separated text, projecting each through the
 * ctx/arch schema order. Thin wrapper around `renderTable`.
 * @param {Array<Record<string, unknown>>} items
 * @param {readonly string[]} fields
 * @param {readonly string[]} schemaOrder
 * @returns {string}
 */
function formatItemsPlain(items, fields, schemaOrder) {
  const projected = items.map((i) => projectItem(i, fields, schemaOrder));
  return renderTable(projected, fields);
}

/**
 * Look up an item in a PRD array by id. Writes a diagnostic and exits 1 if
 * not found; otherwise returns the item.
 * @param {Array<Record<string, unknown>>} items
 * @param {string} itemId
 * @param {string} label
 * @returns {Record<string, unknown> | undefined}
 */
function findItemOrExit(items, itemId, label) {
  const found = items.find((i) => i.id === itemId);
  if (!found) {
    stderr.write(`Error: ${label} ${itemId} not found in PRD.\n`);
    exit(1);
  }
  return found;
}

/**
 * Read an item body from stdin and normalize it to a plain object or exit 1
 * with a diagnostic matching the other mutation handlers.
 * @returns {Record<string, unknown>}
 */
function readStdinItemBody() {
  const body = readStdinJson();
  if (typeof body !== "object" || body === null || Array.isArray(body)) {
    stderr.write("Error: stdin must be a JSON object.\n");
    exit(1);
    // exit() has side-effect typing; return an unreachable cast.
    return /** @type {Record<string, unknown>} */ ({});
  }
  return /** @type {Record<string, unknown>} */ (body);
}

/**
 * If `shapeErrors` is non-empty, write each to stderr as `Error: <msg>` and
 * exit 1. Otherwise no-op.
 * @param {string[]} shapeErrors
 */
function exitOnShapeErrors(shapeErrors) {
  if (shapeErrors.length === 0) {
    return;
  }
  for (const err of shapeErrors) {
    stderr.write(`Error: ${err}\n`);
  }
  exit(1);
}

/**
 * If `items` already contains `newId`, write a diagnostic and exit 1.
 * `label` supplies the human-readable noun (e.g. "Requirement id" or
 * "Context item id") so error messages stay specific.
 * @param {Array<Record<string, unknown>>} items
 * @param {string} newId
 * @param {string} label
 */
function exitOnDuplicateId(items, newId, label) {
  if (items.some((i) => i.id === newId)) {
    stderr.write(`Error: ${label} ${newId} already exists.\n`);
    exit(1);
  }
}

/**
 * Add a context or architecture item. Mirrors `reqAdd` with per-domain
 * validation, schema order, and array key.
 * @param {string} prdPath
 * @param {object} prd
 * @param {ItemDomainSpec} spec
 */
function itemAdd(prdPath, prd, spec) {
  const input = readStdinItemBody();
  const prdObj = /** @type {Record<string, unknown>} */ (prd);
  const items = /** @type {Array<Record<string, unknown>>} */ (
    Array.isArray(prdObj[spec.arrayKey]) ? prdObj[spec.arrayKey] : []
  );

  const candidate = { ...input };
  if (candidate.id === undefined) {
    candidate.id = nextId(spec.prefix, items);
  }

  exitOnShapeErrors(spec.validateShape(candidate, { requireAllFields: true }));

  const newId = /** @type {string} */ (candidate.id);
  exitOnDuplicateId(items, newId, `${spec.notFoundLabel} id`);

  const newItem = fullItemObject(candidate, spec.schemaOrder);
  items.push(newItem);
  prdObj[spec.arrayKey] = items;
  writePrd(prdPath, prd);
  stdout.write(`${JSON.stringify(newItem, null, 2)}\n`);
  exit(0);
}

/**
 * List ctx/arch items with optional filter + field selection. Mirrors
 * `reqLs` but parameterized by domain spec.
 * @param {object} prd
 * @param {ParsedFlags} flags
 * @param {ItemDomainSpec} spec
 */
function itemLs(prd, flags, spec) {
  const prdObj = /** @type {Record<string, unknown>} */ (prd);
  let items = /** @type {Array<Record<string, unknown>>} */ (
    Array.isArray(prdObj[spec.arrayKey]) ? prdObj[spec.arrayKey] : []
  );

  const filterValue = flags.named.get(spec.filterFlag);
  if (filterValue) {
    const values = new Set(filterValue.split(","));
    items = items.filter((i) =>
      values.has(/** @type {string} */ (i[spec.filterField])),
    );
  }

  let fields = spec.defaultListFields;
  const customFields = flags.named.get("--fields") ?? flags.named.get("-f");
  if (customFields) {
    fields = customFields.split(",");
  }

  if (flags.boolean.has("--plain")) {
    stdout.write(formatItemsPlain(items, fields, spec.schemaOrder));
    exit(0);
  }

  const output = items.map((i) => projectItem(i, fields, spec.schemaOrder));
  stdout.write(`${JSON.stringify(output, null, 2)}\n`);
  exit(0);
}

/**
 * Short domain noun (`ctx`/`arch`) used in usage strings and diagnostics.
 * @param {ItemDomainSpec} spec
 * @returns {string}
 */
function domainVerb(spec) {
  return spec.arrayKey === "context" ? "ctx" : "arch";
}

/**
 * Resolve a positional ID and the target items array for ctx/arch
 * show/edit handlers. Returns the found item or undefined when it has
 * already triggered an exit.
 * @param {object} prd
 * @param {ParsedFlags} flags
 * @param {ItemDomainSpec} spec
 * @param {"show" | "edit"} verb
 * @returns {{ items: Array<Record<string, unknown>>, item: Record<string, unknown> | undefined, itemId: string }}
 */
function locateItemByPositional(prd, flags, spec, verb) {
  const suffix = verb === "edit" ? " < patch.json" : "";
  const itemId = requireReqIdPositional(
    flags,
    `clif-d ${domainVerb(spec)} ${verb} <${spec.prefix}-ID> [prd-path]${suffix}`,
  );
  const prdObj = /** @type {Record<string, unknown>} */ (prd);
  const items = /** @type {Array<Record<string, unknown>>} */ (
    Array.isArray(prdObj[spec.arrayKey]) ? prdObj[spec.arrayKey] : []
  );
  const item = findItemOrExit(items, itemId, spec.notFoundLabel);
  return { items, item, itemId };
}

/**
 * Show a single ctx/arch item by id.
 * @param {object} prd
 * @param {ParsedFlags} flags
 * @param {ItemDomainSpec} spec
 */
function itemShow(prd, flags, spec) {
  const { item } = locateItemByPositional(prd, flags, spec, "show");
  if (!item) {
    return;
  }
  stdout.write(
    `${JSON.stringify(fullItemObject(item, spec.schemaOrder), null, 2)}\n`,
  );
  exit(0);
}

/**
 * Edit a ctx/arch item: merge a partial JSON patch from stdin with replace
 * semantics, validate, write atomically. Rejects `id` changes.
 * @param {string} prdPath
 * @param {object} prd
 * @param {ParsedFlags} flags
 * @param {ItemDomainSpec} spec
 */
function itemEdit(prdPath, prd, flags, spec) {
  const { item } = locateItemByPositional(prd, flags, spec, "edit");
  if (!item) {
    return;
  }

  const patch = readStdinItemBody();
  if ("id" in patch) {
    stderr.write(`Error: Cannot change id via ${domainVerb(spec)} edit.\n`);
    exit(1);
    return;
  }

  const merged = { ...item, ...patch };
  exitOnShapeErrors(spec.validateShape(merged, { requireAllFields: true }));

  for (const key of Object.keys(patch)) {
    item[key] = patch[key];
  }
  writePrd(prdPath, prd);
  stdout.write(
    `${JSON.stringify(fullItemObject(item, spec.schemaOrder), null, 2)}\n`,
  );
  exit(0);
}

// -- Validate ---------------------------------------------------------------

/**
 * @typedef {Object} ValidationIssue
 * @property {"error" | "warning"} level
 * @property {string | null} id
 * @property {string} message
 */

/**
 * Run all structural validation checks on the PRD. Returns all issues.
 * @param {object} prd
 * @returns {ValidationIssue[]}
 */
function validate(prd) {
  /** @type {ValidationIssue[]} */
  const issues = [];
  const prdObj = /** @type {Record<string, unknown>} */ (prd);

  const requirements = /** @type {Array<Record<string, unknown>>} */ (
    Array.isArray(prdObj.requirements) ? prdObj.requirements : []
  );
  const contextItems = /** @type {Array<Record<string, unknown>>} */ (
    Array.isArray(prdObj.context) ? prdObj.context : []
  );
  const archItems = /** @type {Array<Record<string, unknown>>} */ (
    Array.isArray(prdObj.architecture) ? prdObj.architecture : []
  );

  checkIdUniqueness(requirements, "REQ", issues);
  checkIdUniqueness(contextItems, "CTX", issues);
  checkIdUniqueness(archItems, "ARCH", issues);

  const reqIds = collectIds(requirements);
  const ctxIds = collectIds(contextItems);
  const archIds = collectIds(archItems);
  checkReferentialIntegrity(requirements, reqIds, ctxIds, archIds, issues);
  checkDependencyCycles(requirements, reqIds, issues);
  checkStatusCommitConsistency(requirements, issues);
  checkEnums(requirements, contextItems, archItems, issues);
  checkRequiredFields(
    requirements,
    ["id", "title", "description", "acceptance_criteria", "abstraction_level"],
    "requirement",
    issues,
  );
  checkRequiredFields(
    contextItems,
    ["id", "title", "description", "type"],
    "context item",
    issues,
  );
  checkRequiredFields(
    archItems,
    ["id", "title", "description", "level"],
    "architecture item",
    issues,
  );

  return issues;
}

/**
 * Flag items missing any required field. Empty strings count as missing.
 * @param {Array<Record<string, unknown>>} items
 * @param {string[]} required
 * @param {string} kind
 * @param {ValidationIssue[]} issues
 */
function checkRequiredFields(items, required, kind, issues) {
  for (const item of items) {
    const id = /** @type {string | undefined} */ (item.id) ?? null;
    for (const field of required) {
      const value = item[field];
      if (value === undefined || value === null || value === "") {
        issues.push({
          level: "error",
          id,
          message: `Missing required ${kind} field: ${field}`,
        });
      }
    }
  }
}

const VALID_STATUSES = new Set([
  "not_started",
  "in_progress",
  "done",
  "blocked",
]);
const VALID_ABSTRACTION_LEVELS = new Set(["high", "low"]);
const VALID_CONTEXT_TYPES = new Set([
  "non_functional",
  "constraint",
  "persona",
  "domain",
  "product_goal",
]);
const VALID_ARCH_LEVELS = new Set(["context", "container", "component"]);

/**
 * @param {Array<Record<string, unknown>>} requirements
 * @param {Array<Record<string, unknown>>} contextItems
 * @param {Array<Record<string, unknown>>} archItems
 * @param {ValidationIssue[]} issues
 */
function checkEnums(requirements, contextItems, archItems, issues) {
  for (const req of requirements) {
    const id = /** @type {string | undefined} */ (req.id) ?? null;
    const status = /** @type {unknown} */ (req.status);
    if (
      status !== undefined &&
      !VALID_STATUSES.has(/** @type {string} */ (status))
    ) {
      issues.push({
        level: "error",
        id,
        message: `Invalid status '${String(status)}'. Must be one of: not_started, in_progress, done, blocked`,
      });
    }
    const level = /** @type {unknown} */ (req.abstraction_level);
    if (
      level !== undefined &&
      !VALID_ABSTRACTION_LEVELS.has(/** @type {string} */ (level))
    ) {
      issues.push({
        level: "error",
        id,
        message: `Invalid abstraction_level '${String(level)}'. Must be 'high' or 'low'`,
      });
    }
  }
  for (const item of contextItems) {
    const id = /** @type {string | undefined} */ (item.id) ?? null;
    const type = /** @type {unknown} */ (item.type);
    if (
      type !== undefined &&
      !VALID_CONTEXT_TYPES.has(/** @type {string} */ (type))
    ) {
      issues.push({
        level: "error",
        id,
        message: `Invalid context type '${String(type)}'. Must be one of: non_functional, constraint, persona, domain, product_goal`,
      });
    }
  }
  for (const item of archItems) {
    const id = /** @type {string | undefined} */ (item.id) ?? null;
    const level = /** @type {unknown} */ (item.level);
    if (
      level !== undefined &&
      !VALID_ARCH_LEVELS.has(/** @type {string} */ (level))
    ) {
      issues.push({
        level: "error",
        id,
        message: `Invalid architecture level '${String(level)}'. Must be one of: context, container, component`,
      });
    }
  }
}

/**
 * Enforce done <-> implementation_commit coupling. done without a commit is
 * an error; a commit without done status is a warning (the commit was likely
 * staged before the status update).
 * @param {Array<Record<string, unknown>>} requirements
 * @param {ValidationIssue[]} issues
 */
function checkStatusCommitConsistency(requirements, issues) {
  for (const req of requirements) {
    const id = /** @type {string | undefined} */ (req.id) ?? null;
    const status = /** @type {string | undefined} */ (req.status);
    const commit = /** @type {string | undefined} */ (
      req.implementation_commit
    );
    if (status === "done" && !commit) {
      issues.push({
        level: "error",
        id,
        message: "Status is 'done' but implementation_commit is missing",
      });
    }
    if (commit && status !== "done") {
      issues.push({
        level: "warning",
        id,
        message: `implementation_commit is set but status is '${status ?? "not_started"}', not 'done'`,
      });
    }
  }
}

/**
 * Detect cycles in the dependency graph using DFS with three-color marking.
 * Only edges pointing to known IDs are traversed; dangling refs are reported
 * separately by checkReferentialIntegrity.
 * @param {Array<Record<string, unknown>>} requirements
 * @param {Set<string>} reqIds
 * @param {ValidationIssue[]} issues
 */
function checkDependencyCycles(requirements, reqIds, issues) {
  const graph = buildDependencyGraph(requirements, reqIds);
  const { color, WHITE, GRAY, BLACK } = initThreeColorState(graph);

  /** @type {Set<string>} */
  const reportedCycles = new Set();

  /**
   * @param {string} node
   * @param {string[]} stack
   */
  function dfs(node, stack) {
    color.set(node, GRAY);
    stack.push(node);
    const edges = graph.get(node) ?? [];
    for (const next of edges) {
      const c = color.get(next);
      if (c === GRAY) {
        const cycleStart = stack.indexOf(next);
        const cyclePath = [...stack.slice(cycleStart), next];
        const key = [...cyclePath].sort().join("|");
        if (!reportedCycles.has(key)) {
          reportedCycles.add(key);
          issues.push({
            level: "error",
            id: next,
            message: `Dependency cycle detected: ${cyclePath.join(" -> ")}`,
          });
        }
      } else if (c === WHITE) {
        dfs(next, stack);
      }
    }
    stack.pop();
    color.set(node, BLACK);
  }

  for (const id of graph.keys()) {
    if (color.get(id) === WHITE) {
      dfs(id, []);
    }
  }
}

/**
 * @param {Array<Record<string, unknown>>} items
 * @returns {Set<string>}
 */
function collectIds(items) {
  /** @type {Set<string>} */
  const ids = new Set();
  for (const item of items) {
    const id = /** @type {string | undefined} */ (item.id);
    if (typeof id === "string") {
      ids.add(id);
    }
  }
  return ids;
}

/**
 * Build the requirement-to-dependency adjacency map used by both cycle
 * detectors. Skips requirements with non-string ids and edges pointing at
 * unknown ids; the validator reports those separately.
 * @param {Array<Record<string, unknown>>} requirements
 * @param {Set<string>} reqIds
 * @returns {Map<string, string[]>}
 */
function buildDependencyGraph(requirements, reqIds) {
  /** @type {Map<string, string[]>} */
  const graph = new Map();
  for (const req of requirements) {
    const id = /** @type {string | undefined} */ (req.id);
    if (typeof id !== "string") {
      continue;
    }
    const deps = /** @type {unknown} */ (req.dependencies);
    const edges = Array.isArray(deps)
      ? deps.filter(
          /** @returns {d is string} */ (d) =>
            typeof d === "string" && reqIds.has(d),
        )
      : [];
    graph.set(id, edges);
  }
  return graph;
}

/**
 * Initialize three-color (WHITE/GRAY/BLACK) DFS state for the graph's nodes.
 * Used by both the boolean cycle detector and the validator's reporting one.
 * @param {Map<string, string[]>} graph
 * @returns {{ color: Map<string, number>, WHITE: 0, GRAY: 1, BLACK: 2 }}
 */
function initThreeColorState(graph) {
  const WHITE = /** @type {const} */ (0);
  const GRAY = /** @type {const} */ (1);
  const BLACK = /** @type {const} */ (2);
  /** @type {Map<string, number>} */
  const color = new Map();
  for (const id of graph.keys()) {
    color.set(id, WHITE);
  }
  return { color, WHITE, GRAY, BLACK };
}

/**
 * Flag any dependency, context_ref, or architecture_ref pointing at a
 * nonexistent ID.
 * @param {Array<Record<string, unknown>>} requirements
 * @param {Set<string>} reqIds
 * @param {Set<string>} ctxIds
 * @param {Set<string>} archIds
 * @param {ValidationIssue[]} issues
 */
function checkReferentialIntegrity(
  requirements,
  reqIds,
  ctxIds,
  archIds,
  issues,
) {
  for (const req of requirements) {
    const id = /** @type {string | undefined} */ (req.id) ?? null;
    checkRefs(
      /** @type {string[] | undefined} */ (req.dependencies),
      reqIds,
      id,
      "dependency",
      issues,
    );
    checkRefs(
      /** @type {string[] | undefined} */ (req.context_refs),
      ctxIds,
      id,
      "context_ref",
      issues,
    );
    checkRefs(
      /** @type {string[] | undefined} */ (req.architecture_refs),
      archIds,
      id,
      "architecture_ref",
      issues,
    );
  }
}

/**
 * @param {string[] | undefined} refs
 * @param {Set<string>} validIds
 * @param {string | null} ownerId
 * @param {string} refKind
 * @param {ValidationIssue[]} issues
 */
function checkRefs(refs, validIds, ownerId, refKind, issues) {
  if (!Array.isArray(refs)) {
    return;
  }
  for (const ref of refs) {
    if (typeof ref !== "string") {
      continue;
    }
    if (!validIds.has(ref)) {
      issues.push({
        level: "error",
        id: ownerId,
        message: `Dangling ${refKind}: ${ref} is not a known ID`,
      });
    }
  }
}

/**
 * Flag duplicate IDs within a namespace.
 * @param {Array<Record<string, unknown>>} items
 * @param {string} namespace
 * @param {ValidationIssue[]} issues
 */
function checkIdUniqueness(items, namespace, issues) {
  /** @type {Set<string>} */
  const seen = new Set();
  for (const item of items) {
    const id = /** @type {string | undefined} */ (item.id);
    if (typeof id !== "string") {
      continue;
    }
    if (seen.has(id)) {
      issues.push({
        level: "error",
        id,
        message: `Duplicate ${namespace} id: ${id}`,
      });
    } else {
      seen.add(id);
    }
  }
}

/**
 * Frozen namespace grouping structural validation. `all` is the single entry
 * point used by `validate` and (from Step 8 onward) by the PRD loader.
 */
const Validation = Object.freeze({
  /**
   * @param {object} prd
   * @returns {ValidationIssue[]}
   */
  all(prd) {
    return validate(prd);
  },
});

/**
 * @param {object} prd
 */
function runValidate(prd) {
  const issues = Validation.all(prd);
  stdout.write(`${JSON.stringify(issues, null, 2)}\n`);
  const hasError = issues.some((i) => i.level === "error");
  exit(hasError ? 1 : 0);
}

// -- Help namespace ---------------------------------------------------------

/**
 * @typedef {{ flag: string, description: string }} HelpFlag
 * @typedef {{ code: number, description: string }} HelpExitCode
 * @typedef {{
 *   usage: string,
 *   description: string,
 *   flags?: HelpFlag[],
 *   exitCodes?: HelpExitCode[],
 * }} HelpSpec
 */

const Help = Object.freeze({
  /**
   * Render a command help spec as plain text. Returns a string ending with
   * a newline. Sections (Flags, Exit codes) are omitted when empty/missing.
   * @param {HelpSpec} spec
   * @returns {string}
   */
  renderCommand(spec) {
    const lines = [`Usage: ${spec.usage}`, "", spec.description];
    if (spec.flags && spec.flags.length > 0) {
      lines.push("", "Flags:");
      const width = Math.max(...spec.flags.map((f) => f.flag.length));
      for (const f of spec.flags) {
        lines.push(`  ${f.flag.padEnd(width)}  ${f.description}`);
      }
    }
    if (spec.exitCodes && spec.exitCodes.length > 0) {
      lines.push("", "Exit codes:");
      for (const ec of spec.exitCodes) {
        lines.push(`  ${ec.code}  ${ec.description}`);
      }
    }
    return `${lines.join("\n")}\n`;
  },
});

